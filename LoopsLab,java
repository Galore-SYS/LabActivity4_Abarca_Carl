import java.util.Scanner;

public class LoopsLab {

    public static void main(String[] arg) {
        Scanner input = new Scanner(System.in);
        int choice;

        do {
            printMenu();
            choice = input.nextInt();

            switch (choice) {
                case 1:
                    System.out.print("Enter your number: ");
                    int case1val = input.nextInt();
                    for(int i = 1; i <= 10; i++){
                        System.out.println("Your multiplication values are "+ case1val + " x " + i +": " +case1val * i);
                    }
                    break;

                case 2:
                   System.out.print("Enter your integer N: ");
                   int case2val = input.nextInt();
                   int sum = 0;
                   int i = 1;
                    while (i <= case2val){
                        sum += 1;
                        i++;
                    }
                    System.out.println(">>>>>Sum of natural numbers from 1 to " + case2val + " is: " + sum);
                    break;

                case 3:
                    int case3input;
                    boolean negative;

                    do {
                        System.out.print("Enter your integer N for the Factorial: ");
                        case3input = input.nextInt();

                        negative = case3input <= 0;

                        if (negative) {
                            System.out.println("Invalid. Please input a positive number...");
                        } else {
                            long fact = 1;
                            int factCounter = 1;

                            while (factCounter <= case3input) {
                                fact *= factCounter;
                                factCounter++;
                            }

                            System.out.println("Your " + case3input + " factorial has the value of: " + fact);
                        }

                    } while (negative);

                    break;

                case 4:
                        System.out.print("Enter your number: ");
                        int case4input = input.nextInt();

                        System.out.println("Even Numbers: ");
                        for (int l = 2; l <= case4input; l += 2){
                            System.out.print(l + " ");
                        }
                        System.out.print("\nOdd numbers: \n");
                        for (int y = 1; y <= case4input; y += 2){
                            System.out.print( y + " ");

                        }
                    
                    break;

                case 5:
                    System.out.print("Enter your number that I'll reverse: ");
                    int case5val = input.nextInt();
                    int reversed = 0;

                    while (case5val > 0) {
                        int lastDigit = case5val % 10;
                        reversed = (reversed * 10) + lastDigit;
                        case5val = case5val / 10;
                    }

                    System.out.println("Reversed: " + reversed);
                   
                    break;

                case 0:
                    System.out.println("Exiting program...");
                    break;

                default:
                    System.out.println("Invalid choice");
                    break;
            }
        } while (choice != 0);

        input.close();
    }



    public static void printMenu(){
    System.out.println("\n=====================================");
    System.out.println("Welcome! I AM LYV (LYV-MATH PROGRAM)");
    System.out.println("=====================================");
    System.out.println("1. Multiplication Table Generator");
    System.out.println("2. Sum of Natural Numbers");
    System.out.println("3. Factorial Calculator");
    System.out.println("4. Even and Odd Numbers");
    System.out.println("5. Reverse Digits of a Number");
    System.out.println("0. Exit the Program");}


}

